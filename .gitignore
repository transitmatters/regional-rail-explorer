# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc

# Node crash reports
report.*.json

# Scenarios JSON (computed at build from data/)
scenarios.json

# VSCode settings
.vscode

# TypeScript stuff
*.tsbuildinfo

# private keys
*.pem

# IDE files
/.idea
*storybook.log
.cursor


# Packaged standalone build that Lambda runs (see devops/package-release.sh)
/release/
# /_next/static, uploaded to S3 by devops/deploy.sh
/release-static/
# Template written by `aws cloudformation package` in devops/deploy.sh
/devops/packaged.json
